/** One owner, one store. No remote loading, no processing by passive parts. */
public final class NuclearController extends TileEntity implements ITickable {
 public static final int CAPACITY=1000000, FE_PER_TICK=200, FUEL_TICKS=2400, WATER_CAPACITY=8000, SCRAM=1000, RESET=400, OUTPUT=400;
 public int energy,temperature,fuelTicks,production; public boolean enabled, scrammed, formed;
 // Opt-in for old worlds: empty coolant trips a latched manual reset.
 private boolean coolantGuard;
 public boolean coolantGuard(){return coolantGuard;}
 void setCoolantGuard(boolean value){
   if(!usable())return;
   coolantGuard=value;
   if(value && enabled && water()==0)tripCoolantGuard();
   markDirty();
 }
 private void tripCoolantGuard(){
   enabled=false;scrammed=true;production=0;setIndicator(false);markDirty();
 }
 private boolean reserved, updating, removing, removalDrained, bucketTransfer, filling; private int activeOperations;
 private boolean visualFormed;
 boolean visualFormed(){return visualFormed;}
 private void setVisualFormed(boolean value){
   if(visualFormed==value)return;
   visualFormed=value;
   if(world!=null && !world.isRemote && world.isBlockLoaded(pos)){
     IBlockState s=world.getBlockState(pos);world.notifyBlockUpdate(pos,s,s,3);
   }
 }
 @Override public NBTTagCompound getUpdateTag(){NBTTagCompound n=super.writeToNBT(new NBTTagCompound());n.setBoolean("VisualFormed",visualFormed);return n;}
 @Override public void handleUpdateTag(NBTTagCompound n){visualFormed=n.getBoolean("VisualFormed");}
 @Override public SPacketUpdateTileEntity getUpdatePacket(){return new SPacketUpdateTileEntity(pos,0,getUpdateTag());}
 @Override public void onDataPacket(NetworkManager net,SPacketUpdateTileEntity packet){handleUpdateTag(packet.getNbtCompound());if(world!=null)world.markBlockRangeForRenderUpdate(pos,pos);}
 private final List<ItemStack> recoveryOverflow=new ArrayList<>();
 private int outputThisTick; private long outputTick=Long.MIN_VALUE;
 /** Move inventory to dimension storage before the tile is removed; callbacks cannot drain it twice. */
 void onControllerRemoved(){
   if(removing)return;
   NuclearRecovery recovery=NuclearRecovery.get(world);
   removing=true;
   setVisualFormed(false);
   syncPartVisuals(false);
   if(activeOperations>0)return;
   finishRemoval(recovery);
 }
 private void finishRemoval(NuclearRecovery recovery){
   if(removalDrained)return;
   removalDrained=true;
   releaseStructure();
   for(int i=0;i<inventory.getSlots();i++){
     ItemStack stack=inventory.getStackInSlot(i);
     if(!stack.isEmpty()){
       recovery.enqueue(pos,stack);
       inventory.setStackInSlot(i,ItemStack.EMPTY);
     }
   }
   for(ItemStack stack:recoveryOverflow)recovery.enqueue(pos,stack);
   recoveryOverflow.clear();
 }
 // Defer inventory draining until the outermost GUI/tick transaction finishes.
 boolean beginOperation(){if(bucketTransfer || !usable() || validateStructure()!=1)return false;activeOperations++;return true;}
 private boolean beginTickOperation(){if(!usable())return false;activeOperations++;return true;}
 void endOperation(){if(--activeOperations==0 && removing)finishRemoval(NuclearRecovery.get(world));}
 public final ItemStackHandler inventory=new ItemStackHandler(3) {
   @Override public boolean isItemValid(int slot,ItemStack s){ return slot==0?isFuel(s):slot==1?s.getItem()==Items.WATER_BUCKET:false; }
   @Override public ItemStack insertItem(int slot,ItemStack s,boolean simulate){
     if(!s.isEmpty() && !isItemValid(slot,s))return s;
     return super.insertItem(slot,s,simulate);
   }
   @Override protected void onContentsChanged(int slot){markDirty();}
 };
 // Automation can insert only inputs and extract only the output. Internal operations use inventory.
 private final IItemHandler automation=new IItemHandler(){
   public int getSlots(){return inventory.getSlots();}
   public ItemStack getStackInSlot(int slot){return inventory.getStackInSlot(slot).copy();}
   public ItemStack insertItem(int slot,ItemStack stack,boolean simulate){return !bucketTransfer && usable()?inventory.insertItem(slot,stack,simulate):stack;}
   public ItemStack extractItem(int slot,int amount,boolean simulate){
     if(bucketTransfer || !usable())return ItemStack.EMPTY;
     if(slot!=2){inventory.getStackInSlot(slot);return ItemStack.EMPTY;}
     return inventory.extractItem(slot,amount,simulate);
   }
   public int getSlotLimit(int slot){return inventory.getSlotLimit(slot);}
 };
 private final FluidTank tank=new FluidTank(WATER_CAPACITY) {
   @Override public boolean canFillFluidType(FluidStack f){return f!=null && f.getFluid()==FluidRegistry.WATER;}
   @Override public boolean canDrain(){return false;}
   @Override public boolean canDrainFluidType(FluidStack f){return false;}
   @Override protected void onContentsChanged(){markDirty();}
 };
 // Cached capabilities must not accept contents after the controller is removed.
 private final IFluidHandler fluidInput=new IFluidHandler(){
   public IFluidTankProperties[] getTankProperties(){return tank.getTankProperties().clone();}
   public int fill(FluidStack fluid,boolean doFill){
     if(bucketTransfer || filling || !usable() || fluid==null || fluid.getFluid()!=FluidRegistry.WATER || fluid.amount<=0)return 0;
     // Bound before calling Forge's tank to avoid integer overflow on hostile offers.
     int amount=Math.min(fluid.amount,Math.max(0,WATER_CAPACITY-water()));
     if(amount==0)return 0;
     // Store plain water so tagged water cannot block normal pipes or buckets.
     FluidStack bounded=new FluidStack(FluidRegistry.WATER,amount);
     filling=true;
     try{return tank.fill(bounded,doFill);}finally{filling=false;}
   }
   public FluidStack drain(FluidStack fluid,boolean doDrain){return null;}
   public FluidStack drain(int amount,boolean doDrain){return null;}
 };
 private final IEnergyStorage storage=new IEnergyStorage(){
   public int receiveEnergy(int n,boolean sim){return 0;}
   public int extractEnergy(int n,boolean sim){return extractEnergyChecked(n,sim,null,null);}
   public int getEnergyStored(){return usable() && validateStructure()==1?energy:0;} public int getMaxEnergyStored(){return CAPACITY;}
   public boolean canExtract(){return usable() && validateStructure()==1;} public boolean canReceive(){return false;}
 };
 private int extractEnergyChecked(int n,boolean sim,NuclearPart part,Object lease){
     if(part!=null && !part.validLease(this,lease))return 0;
     if(!usable() || reserved || n<=0 || validateStructure()!=1)return 0;
     if(part!=null && !part.validL