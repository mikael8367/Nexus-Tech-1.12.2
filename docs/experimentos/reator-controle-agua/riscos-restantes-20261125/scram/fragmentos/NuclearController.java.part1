/** One owner, one store. No remote loading, no processing by passive parts. */
public final class NuclearController extends TileEntity implements ITickable {
 public static final int CAPACITY=1000000, FE_PER_TICK=200, FUEL_TICKS=2400, WATER_CAPACITY=8000, SCRAM=1000, RESET=400, OUTPUT=400;
 public int energy,temperature,fuelTicks,production; public boolean enabled, scrammed, formed;
 private final AutoThermalControl autoThermal=new AutoThermalControl();
 public boolean autoTemperatureEnabled(){return autoThermal.enabled();}
 public boolean autoTemperatureInvalid(){return autoThermal.invalid();}
 public int autoTemperatureTarget(){return autoThermal.target();}
 // Server-side API only; no network handler/GUI is added by this experiment.
 /** Explicit repair replaces the corrupt configuration, turns automatic mode off, and does not reset SCRAM. */
 public boolean repairAutoTemperatureConfig(int target){
   if(!usable() || enabled || configuring || starting || stopping || updating || reserved || filling || bucketTransfer || automationExtracting || activeOperations>0 || !autoThermal.invalid())return false;
   configuring=true;
   try{if(!autoThermal.repair(target))return false;markDirty();return true;}
   catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
   finally{configuring=false;}
 }
 public boolean setAutoTemperatureTarget(int target){
   if(!usable() || configuring || starting || stopping || updating || reserved || filling || bucketTransfer || automationExtracting || activeOperations>0)return false;
   configuring=true;
   try{if(!autoThermal.setTarget(target))return false;markDirty();return true;}
   catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
   finally{configuring=false;}
 }
 public boolean setAutoTemperatureEnabled(boolean value){
   if(!usable() || configuring || starting || stopping || updating || reserved || filling || bucketTransfer || automationExtracting || activeOperations>0)return false;
   if(value && autoThermal.invalid())return false;
   // Block nested configuration/start but permit an emergency stop in callbacks.
   configuring=true;boolean tripAttempted=false;
   try{
     autoThermal.setEnabled(value);
     if(value && enabled && water()==0){tripAttempted=true;tripCoolantGuard();}
     else markDirty();
     return true;
   } catch(RuntimeException | Error ex){
     // A trip already attempted both notifications and retained failures.
     if(!tripAttempted)notifyScramAfterFailure(ex);
     throw ex;
   } finally {configuring=false;}
 }
 /** Diagnostic is instantaneous, not a guarantee of future stability. */
 public String autoTemperatureStatus(){
   if(autoThermal.invalid())return "INVALID_CONFIG";
   if(!autoThermal.enabled())return "OFF";
   if(scrammed || temperature>=SCRAM)return "PROTECTION";
   if(!enabled)return "REACTOR_OFF";
   if(!formed)return "STRUCTURE";
   if(water()==0)return "NO_COOLANT_PROTECTION";
   if(!hasFuel())return "NO_FUEL";
   if(energy>CAPACITY-FE_PER_TICK)return "ENERGY_SATURATED";
   return temperature==autoThermal.target()?"AT_TARGET":"ADJUSTING";
 }
 // Opt-in for old worlds: empty coolant trips a latched manual reset.
 private boolean coolantGuard;
 public boolean coolantGuard(){return coolantGuard;}
 void setCoolantGuard(boolean value){
   if(!usable() || configuring || starting || stopping || updating || reserved || filling || bucketTransfer || automationExtracting || activeOperations>0)return;
   // Configuration callbacks may request an emergency stop, but not a start.
   configuring=true;boolean tripAttempted=false;
   try{
     coolantGuard=value;
     if(value && enabled && water()==0){tripAttempted=true;tripCoolantGuard();}
     else markDirty();
   } catch(RuntimeException | Error ex){
     if(!tripAttempted)notifyScramAfterFailure(ex);
     throw ex;
   } finally {configuring=false;}
 }
 private void tripCoolantGuard(){
   enabled=false;scrammed=true;production=0;
   pendingScramIndicator=true;pendingScramDirty=true;
   retryScramNotifications();
 }
 // Notifications are best-effort only: markDirty does not prove a disk save.
 // Each failure stays pending and is retried on ticks before allowing restart.
 private void retryScramNotifications(){
   Throwable first=null;
   try{
     // Clear before callback so a reentrant SCRAM can set the flag again.
     if(pendingScramIndicator){pendingScramIndicator=false;try{if(!setIndicator(false))pendingScramIndicator=true;}catch(RuntimeException | Error ex){pendingScramIndicator=true;first=ex;}}
     if(pendingScramDirty){
       pendingScramDirty=false;
       try{if(usable()){markDirty();if(!usable())pendingScramDirty=true;}else pendingScramDirty=true;}
       catch(RuntimeException | Error ex){pendingScramDirty=true;if(first==null)first=ex;else if(first!=ex)first.addSuppressed(ex);}
     }
   }finally{enabled=false;scrammed=true;production=0;}
   if(first instanceof RuntimeException)throw (RuntimeException)first;
   if(first instanceof Error)throw (Error)first;
 }
 private void notifyScramAfterFailure(Throwable original){
   try{tripCoolantGuard();}catch(RuntimeException | Error notification){if(notification!=original)original.addSuppressed(notification);}
 }
 private boolean configuring, pendingScramDirty, pendingScramIndicator;
 private boolean reserved, updating, starting, startInterrupted, stopping, removing, removalDrained, removalFinalizing, removalUncertain, bucketTransfer, filling, automationExtracting; private int activeOperations;
 private boolean visualFormed;
 boolean visualFormed(){return visualFormed;}
 private void setVisualFormed(boolean value){
   if(visualFormed==value)return;
   visualFormed=value;
   if(world!=null && !world.isRemote && world.isBlockLoaded(pos)){
     IBlockState s=world.getBlockState(pos);world.notifyBlockUpdate(pos,s,s,3);
   }
 }
 @Override public NBTTagCompound getUpdateTag(){NBTTagCompound n=super.writeToNBT(new NBTTagCompound());n.setBoolean("VisualFormed",visualFormed);return n;}
 @Override public void handleUpdateTag(NBTTagCompound n){visualFormed=n.getBoolean("VisualFormed");}
 @Override public SPacketUpdateTileEntity getUpdatePacket(){return new SPacketUpdateTileEntity(pos,0,getUpdateTag());}
 @Override public void onDataPacket(NetworkManager net,SPacketUpdateTileEntity packet){handleUpdateTag(packet.getNbtCompound());if(world!=null)world.markBlockRangeForRenderUpdate(pos,pos);}
 private final List<ItemStack> recoveryOverflow=new ArrayList<>();
 private int outputThisTick; private long outputTick=Long.MIN_VALUE;
 /** Move inventory to dimension storage before the tile is removed; callbacks cannot drain it twice. */
 void onControllerRemoved(){
   if(removing)return;
   NuclearRecovery recovery=NuclearRecovery.get(world);
   removing=true;
   try{setVisualFormed(false);syncPartVisuals(false);}
   finally{if(activeOperations==0)finishRemoval(recovery);}
 }
 private void finishRemoval(NuclearRecovery recovery){
   if(removalDrained || removalFinalizing || removalUncertain)return;
   removalFinalizing=true;
   try {
     // Mapped Forge setFluid and our raw slot assignment have no world callback.
     int amount=water();if(amount>0){recovery.enqueueWater(pos,amount);tank.setFluid(null);}
     for(int i=0;i<inventory.getSlots();i++){
       ItemStack stack=inventory.getStackInSlot(i);
       if(!stack.isEmpty()){
         recovery.enqueue(pos,stack);
         recoveryInventory.setWithoutNotification(i,ItemStack.EMPTY);
       }
     }
     while(!recoveryOverflow.isEmpty()){
       recovery.enqueue(pos,recoveryOverflow.get(0));recoveryOverflow.remove(0);
     }
     removalDrained=true;
   } catch(RuntimeException | Error ex){
     // Ownership may have changed before a failure. Never automatically replay it.
     removalUncertain=true;throw ex;
   } finally {removalFinalizing=false;}
   releaseStructure();
 }
 // Defer inventory draining until the outermost GUI/tick transaction finishes.
 boolean beginOperation(){if(bucketTransfer || automationExtracting || !usable() || validateStructure()!=1)return false;activeOperations++;return true;}
 private boolean beginTickOperation(){if(!usable())return false;activeOperations++;return true;}
 void endOperation(){if(--activeOperations==0 && removing)finishRemoval(NuclearRecovery.get(world));}
 private final RecoveryInventory recoveryInventory=new RecoveryInventory();
 // Keep the public field's ItemStackHandler descriptor for existing integrations.
 public final ItemStackHandler inventory=recoveryInventory;
 private final class RecoveryInventory e