;x++)for(int y=0;y<5;y++)for(int d=0;d<3;d++){
     if(x==0&&y==0&&d==0)continue;
     BlockPos q=at(pos,front,x,y,d);
     BlockPos owner=((NuclearPart)world.getTileEntity(q)).owner;
     if(owner!=null&&!owner.equals(pos)){
       if(!world.isBlockLoaded(owner))return -1;
       TileEntity old=world.getTileEntity(owner);
       if(old instanceof NuclearController){
         NuclearController c=(NuclearController)old;
         // Damaged but hot/armed owners keep their bindings until safe.
         if(c.enabled || c.temperature>RESET)return 0;
         int oldGeometry=c.validateGeometry();
         if(oldGeometry<0)return -1;
         if(oldGeometry==1 && c.containsPart(q))return 0;
       }
     }
   }
   return 1;
 }
 /** Called only after a successful pure validation, on an actual server operation. */
 private void bindStructure(){
   if(validateStructure()!=1)return;
   EnumFacing front=world.getBlockState(pos).getValue(BlockHorizontal.FACING);
   for(int x=-1;x<=1;x++)for(int y=0;y<5;y++)for(int d=0;d<3;d++){
     if(x==0&&y==0&&d==0)continue;
     BlockPos q=at(pos,front,x,y,d);
     if(!usable() || !world.isBlockLoaded(q))return;
     TileEntity t=world.getTileEntity(q);if(!(t instanceof NuclearPart))return;
     ((NuclearPart)t).bind(pos);
   }
 }
 /** Claim and publish a valid structure before opening from any of its parts. */
 boolean prepareForGui(){
   if(validateStructure()!=1)return false;
   bindStructure();
   if(!allPartsBound()){stopForStructureLoss();return false;}
   formed=true;
   setVisualFormed(true);
   syncPartVisuals(true);
   if(!allPartsBound()){stopForStructureLoss();return false;}
   return true;
 }
 private boolean allPartsBound(){
   if(validateStructure()!=1)return false;
   EnumFacing front=world.getBlockState(pos).getValue(BlockHorizontal.FACING);
   for(int x=-1;x<=1;x++)for(int y=0;y<5;y++)for(int d=0;d<3;d++){
     if(x==0&&y==0&&d==0)continue;
     BlockPos q=at(pos,front,x,y,d);
     if(!world.isBlockLoaded(q))return false;
     TileEntity t=world.getTileEntity(q);
     if(!(t instanceof NuclearPart) || t.isInvalid() || !pos.equals(((NuclearPart)t).owner))return false;
   }
   return true;
 }
 private void syncPartVisuals(boolean value){
   if(world==null || world.isRemote || !world.isBlockLoaded(pos))return;
   IBlockState s=world.getBlockState(pos);if(s.getBlock()!=NuclearRegistry.CONTROLLER)return;
   EnumFacing front=s.getValue(BlockHorizontal.FACING);
   for(int x=-1;x<=1;x++)for(int y=0;y<5;y++)for(int d=0;d<3;d++){
     if(x==0&&y==0&&d==0)continue;
     BlockPos q=at(pos,front,x,y,d);if(!world.isBlockLoaded(q))continue;
     TileEntity t=world.getTileEntity(q);
     if(t instanceof NuclearPart && pos.equals(((NuclearPart)t).owner))((NuclearPart)t).setVisualFormed(value);
   }
 }
 /** Release only loaded parts still owned by this controller; never touches inventories. */
 void releaseStructure(){
   if(world==null || world.isRemote || !world.isBlockLoaded(pos))return;
   if(enabled || temperature>RESET)return;
   IBlockState state=world.getBlockState(pos); if(state.getBlock()!=NuclearRegistry.CONTROLLER)return;
   EnumFacing front=state.getValue(BlockHorizontal.FACING);
   for(int x=-1;x<=1;x++)for(int y=0;y<5;y++)for(int d=0;d<3;d++){
     if(x==0&&y==0&&d==0)continue;
     BlockPos q=at(pos,front,x,y,d); if(!world.isBlockLoaded(q))continue;
     TileEntity t=world.getTileEntity(q);
     if(t instanceof NuclearPart)((NuclearPart)t).unbind(pos);
   }
 }
 private void acceptBucket(){
   ItemStack in=inventory.getStackInSlot(1),out=inventory.getStackInSlot(2);
   ItemStack empty=new ItemStack(Items.BUCKET);
   if(in.isEmpty() || in.getItem()!=Items.WATER_BUCKET || tank.getCapacity()-water()<1000 || (!out.isEmpty() && (!ItemStack.areItemsEqual(out,empty) || !ItemStack.areItemStackTagsEqual(out,empty) || out.getCount()>=out.getMaxStackSize())))return;
   // Tick operation defers removal. Copies may consult modded item capabilities,
   // so lock before preparing them and abandon the transfer if removal intervenes.
   bucketTransfer=true;
   try {
     ItemStack nextIn=in.copy();nextIn.shrink(1);if(nextIn.isEmpty())nextIn=ItemStack.EMPTY;
     ItemStack nextOut=out.isEmpty()?empty:out.copy();if(!out.isEmpty())nextOut.grow(1);
     FluidStack nextWater=new FluidStack(FluidRegistry.WATER,water()+1000);
     if(removing || !usable())return;
     // No world callbacks in the three assignments under the mapped Forge version.
     tank.setFluid(nextWater);
     recoveryInventory.setWithoutNotification(1,nextIn);
     recoveryInventory.setWithoutNotification(2,nextOut);
     // Mutation is committed even if a synchronous world callback throws.
     try{markDirty();}catch(RuntimeException ex){org.apache.logging.log4j.LogManager.getLogger("NexusTech").error("Nuclear bucket conversion notification failed after mutation; chunk may not be marked dirty",ex);}
   } finally {bucketTransfer=false;}
 }
 private boolean startSafe(){
   return !startInterrupted && !pendingScramDirty && !pendingScramIndicator && !autoThermal.invalid() && temperature>=0 && temperature<SCRAM
       && energy>=0 && energy<=CAPACITY && fuelTicks>=0 && (!scrammed || temperature<=RESET)
       && (!(coolantGuard || autoThermal.enabled()) || water()>0) && hasFuel();
 }
 private void abortUnsafeStart(boolean latch){
   if(pendingScramDirty || pendingScramIndicator){retryScramNotifications();return;}
   if(enabled && (temperature>=SCRAM || ((coolantGuard || autoThermal.enabled()) && water()==0))){tripCoolantGuard();return;}
   if(latch){tripCoolantGuard();return;}
   boolean wasEnabled=enabled;
   enabled=false;production=0;
   if(wasEnabled){setIndicator(false);markDirty();}
 }
 public void setEnabled(boolean value){
   // A nested attempt, including a nested stop, invalidates the outer start.
   if(starting){startInterrupted=true;enabled=false;scrammed=true;production=0;pendingScramIndicator=true;pendingScramDirty=true;return;}
   if(stopping)return;
   if(!usable())return;
   if(!value){
     stopping=true;enabled=false;production=0;
     try{setIndicator(false);markDirty();}
     catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
     finally{enabled=false;production=0;stopping=false;}
     return;
   }
   if(configuring || pendingScramDirty || pendingScramIndicator || updating || reserved || filling || bucketTransfer || automationExtracting || activeOperations>0)return;
   starting=true;startInterrupted=false;
   try{
     if(!startSafe()){abortUnsafeStart(false);return;}
     int structure=validateStructure();
     if(structure!=1){stopForStructureLoss();return;}
     formed=true;
     if(!startSafe()){abortUnsafeStart(true);return;}
     bindStructure();
     if(!usable() || !allPartsBound()){stopForStructureLoss();return;}
     if(!startSafe()){abortUnsafeStart(false);return;}
     enabled=true;scrammed=false;markDirty();
     // markDirty is a callback boundary too.
     if(!usable() || !allPartsBound() || !startSafe()){abortUnsafeStart(true);}
   } catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
   finally{starting=false;}
 }
 /** A structural interruption is latched; restoring chunks/blocks alone cannot restart. */
 private void stopForStructureLoss(){
   boolean latch=enabled;
   enabled=false;formed=false;production=0;
   if(latch){scrammed=true;pendingScramIndicator=true;pendingScramDirty=true;}
   try{setVisualFormed(false);syncPartVisuals(false);}
   catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
   if(latch){retryScramNotifications();return;}
   try{setIndicator(false);if(usable())markDirty();}
   catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
 }
 @Override public void update(){
   // Guard the whole tick, including operation setup and teardown, against callbacks.
   // A nested tick during Forge's fill callback can change its return value or
   // empty the tank before fillInternal finishes reading it.
   if(configuring || starting || stopping || updating || reserved || filling || automationExtracting)return;
   updating=true;
   try {
   if(!beginTickOperation())return;
   try {
   if(pendingScramDirty || pendingScramIndicator)retryScramNotifications();
   boolean drainInterrupted=false;
   resetOutputForWorldTick();
   int structure=validateStructure(); formed=structure==1;
   if(structure==1){
     bindStructure();
     structure=validateStructure();formed=structure==1;
     if(structure==1){setVisualFormed(true);syncPartVisuals(true);structure=validateStructure();}
     if(structure==1 && !allPartsBound())structure=validateStructure()==-1?-1:0;
   }
   if(structure!=1){stopForStructureLoss();if(structure==0)releaseStructure();}
   // A missing chunk pauses everything, including coolant, heat and output.
   if(structure<0){production=0;setIndicator(false);return;}
   if(removing)return;
   acceptBucket(); if(removing)return; production=0;
   if(autoThermal.invalid()){enabled=false;scrammed=true;}
   if(enabled && (coolantGuard || autoThermal.enabled()) && water()==0)tripCoolantGuard();
   if(enabled && !hasFuel())enabled=false;
   // Never generate at/above the critical threshold, in any mode.
   if(temperature>=SCRAM){enabled=false;scrammed=true;}
   if(enabled && formed && energy<=CAPACITY-FE_PER_TICK){
     if(fuelTicks==0 && isFuel(inventory.getStackInSlot(0))) {
       ItemStack consumed=inventory.extractItem(0,1,false);
       // A reentrant removal defers draining until endOperation: preserve the item there.
