olantGuard || autoThermal.enabled()) && water()==0)tripCoolantGuard();
     // A fuel-extraction callback may have changed temperature after the first check.
     if(autoThermal.invalid() || temperature>=SCRAM){enabled=false;scrammed=true;}
     if(enabled && usable() && fuelTicks>0 && energy>=0 && energy<=CAPACITY-FE_PER_TICK && temperature<SCRAM){
       boolean applyWater=autoThermal.applyWater(temperature);
       boolean cooled=water()>0 && applyWater;
       int beforeWater=water();
       // Drain can notify foreign code. Do not commit fuel/FE before it returns.
       if(cooled)tank.drainInternal(1,true);
       if(cooled && (temperature>=SCRAM || !enabled || autoThermal.invalid() || !usable()
           || !allPartsBound() || temperature>=SCRAM || !enabled || autoThermal.invalid() || water()!=beforeWater-1 || energy<0 || energy>CAPACITY-FE_PER_TICK || fuelTicks<=0)){
         enabled=false;scrammed=true;production=0;drainInterrupted=true;
       } else {
         temperature+=3;
         if(temperature>=SCRAM){enabled=false;scrammed=true;production=0;}
         else {
           fuelTicks--; energy+=FE_PER_TICK; production=FE_PER_TICK;
           if(cooled)temperature=Math.max(0,temperature-4);
           if(enabled && (coolantGuard || autoThermal.enabled()) && water()==0){tripCoolantGuard();if(autoThermal.enabled())production=FE_PER_TICK;}
         }
       }
     }
   }
   if(enabled && !hasFuel())enabled=false;
   temperature=Math.max(0,temperature-1);
   // SCRAM remains latched; water assists cooling only above the manual reset
   // threshold, never below it. Passive cooling still has its original floor 0.
   if(!drainInterrupted && scrammed && !enabled && temperature>RESET && water()>0){
     tank.drainInternal(1,true);
     // Never mask a critical value introduced by a drain callback.
     if(temperature>=SCRAM){enabled=false;scrammed=true;}
     else temperature=Math.max(RESET,temperature-4);
   }
   if(temperature>=SCRAM){enabled=false;scrammed=true;}
   setIndicator(enabled && production>0);
   if(formed)pushOutput(); markDirty();
   } finally {endOperation();}
   } catch(RuntimeException | Error ex){notifyScramAfterFailure(ex);throw ex;}
   finally {if(temperature>=SCRAM || autoThermal.invalid()){enabled=false;scrammed=true;}updating=false;}
 }
 private boolean setIndicator(boolean active){
   // A callback may have installed another controller at this position.
   if(!usable())return false;
   IBlockState s=world.getBlockState(pos);
   if(!usable() || s.getBlock()!=NuclearRegistry.CONTROLLER)return false;
   if(s.getValue(NuclearBlock.ACTIVE)==active)return usable();
   return world.setBlockState(pos,s.withProperty(NuclearBlock.ACTIVE,active),3) && usable();
 }
 private void pushOutput(){
   if(validateStructure()!=1)return;
   EnumFacing front=world.getBlockState(pos).getValue(BlockHorizontal.FACING);
   List<BlockPos> sources=new ArrayList<>();sources.add(pos);
   for(int x=-1;x<=1;x++)for(int y=0;y<5;y++)for(int d=0;d<3;d++)
     if(!(x==0&&y==0&&d==0))sources.add(at(pos,front,x,y,d));
   for(BlockPos source:sources)for(EnumFacing side:EnumFacing.VALUES){
     if(!usable() || validateStructure()!=1)return;
     int offer=Math.min(energy,OUTPUT-outputThisTick);if(offer<=0)return;
     BlockPos target=source.offset(side);if(!world.isBlockLoaded(target))continue;
     TileEntity other=world.getTileEntity(target);
     if(other==null || other.isInvalid() || other instanceof NuclearPart || other instanceof NuclearController)continue;
     try {
       IEnergyStorage receiver=other.getCapability(CapabilityEnergy.ENERGY,side.getOpposite());
       if(receiver==null || !receiver.canReceive())continue;
       // Capability resolution and canReceive are foreign callbacks: recheck everything.
       if(!usable() || validateStructure()!=1)return;
       if(!world.isBlockLoaded(target) || world.getTileEntity(target)!=other || other.isInvalid())continue;
       resetOutputForWorldTick();offer=Math.min(energy,OUTPUT-outputThisTick);if(offer<=0)return;
       energy-=offer;outputThisTick+=offer;reserved=true;
       int got=clamp(receiver.receiveEnergy(offer,false),offer);
       energy+=offer-got;outputThisTick-=offer-got;
     } catch(RuntimeException ex) {
       // A receiver may have accepted the reservation before throwing. Never refund it.
     } finally {reserved=false;}
   }
 }
 @Override public boolean hasCapability(Capability<?> cap,@Nullable EnumFacing face){
   if(cap==CapabilityEnergy.ENERGY)return world!=null && (world.isRemote?visualFormed:usable() && validateStructure()==1);
   return cap==CapabilityFluidHandler.FLUID_HANDLER_CAPABILITY || cap==CapabilityItemHandler.ITEM_HANDLER_CAPABILITY || super.hasCapability(cap,face);
 }
 @Override public <T>T getCapability(Capability<T> cap,@Nullable EnumFacing face){
   if(cap==CapabilityEnergy.ENERGY)return hasCapability(cap,face)?CapabilityEnergy.ENERGY.cast(storage):null;
   if(cap==CapabilityFluidHandler.FLUID_HANDLER_CAPABILITY)return CapabilityFluidHandler.FLUID_HANDLER_CAPABILITY.cast(fluidInput);
   if(cap==CapabilityItemHandler.ITEM_HANDLER_CAPABILITY)return CapabilityItemHandler.ITEM_HANDLER_CAPABILITY.cast(automation);
   return super.getCapability(cap,face);
 }
 @Override public NBTTagCompound writeToNBT(NBTTagCompound n){super.writeToNBT(n);n.setLong("OutputTick",outputTick);n.setInteger("OutputThisTick",outputThisTick);n.setInteger("Energy",energy);n.setInteger("Temperature",temperature);n.setInteger("FuelTicks",fuelTicks);n.setBoolean("Enabled",enabled);n.setBoolean("Scrammed",scrammed);n.setBoolean("CoolantGuard",coolantGuard);autoThermal.write(n);n.setTag("Inventory",inventory.serializeNBT());NBTTagList overflow=new NBTTagList();for(ItemStack stack:recoveryOverflow)overflow.appendTag(stack.writeToNBT(new NBTTagCompound()));n.setTag("RecoveryOverflow",overflow);n.setTag("Tank",tank.writeToNBT(new NBTTagCompound()));return n;}
 @Override public void readFromNBT(NBTTagCompound n){
   if(configuring||starting||stopping||updating||reserved||filling||bucketTransfer||automationExtracting||activeOperations>0||removing)return;
   // If a read throws, the reactor remains stopped and latched.
   enabled=false;scrammed=true;production=0;
   try{
     super.readFromNBT(n);energy=clamp(n.getInteger("Energy"),CAPACITY);temperature=clamp(n.getInteger("Temperature"),SCRAM);fuelTicks=clamp(n.getInteger("FuelTicks"),FUEL_TICKS);
     coolantGuard=n.getBoolean("CoolantGuard");autoThermal.read(n);readInventory(n);tank.readFromNBT(n.getCompoundTag("Tank"));
     FluidStack loaded=tank.getFluid();if(loaded==null || loaded.getFluid()!=FluidRegistry.WATER || loaded.amount<=0)tank.setFluid(null);else tank.setFluid(new FluidStack(FluidRegistry.WATER,Math.min(loaded.amount,WATER_CAPACITY)));
     formed=false;outputTick=n.hasKey("OutputTick")?n.getLong("OutputTick"):Long.MIN_VALUE;outputThisTick=clamp(n.getInteger("OutputThisTick"),OUTPUT);
     enabled=false;scrammed=n.getBoolean("Scrammed") || n.getBoolean("Enabled") || temperature>=SCRAM || autoThermal.invalid();
   }catch(RuntimeException | Error ex){enabled=false;scrammed=true;production=0;autoThermal.invalidate();throw ex;}
 }
 private void readInventory(NBTTagCompound n){
   recoveryOverflow.clear();
   NBTTagList savedOverflow=n.getTagList("RecoveryOverflow",10);
   for(int i=0;i<savedOverflow.tagCount();i++){
     ItemStack stack=new ItemStack(savedOverflow.getCompoundTagAt(i));
     if(!stack.isEmpty())recoveryOverflow.add(stack);
   }
   NBTTagCompound source=n.getCompoundTag("Inventory"),fixed=new NBTTagCompound();
   NBTTagList items=source.getTagList("Items",10),normal=new NBTTagList();
   boolean[] occupied=new boolean[3];
   for(int i=0;i<items.tagCount();i++){
     NBTTagCompound tag=items.getCompoundTagAt(i);int slot=tag.getInteger("Slot");
     ItemStack stack=new ItemStack(tag);
     if(stack.isEmpty())continue;
     if(slot>=0 && slot<3 && !occupied[slot]){occupied[slot]=true;normal.appendTag(tag.copy());}
     else recoveryOverflow.add(stack);
   }
   fixed.setInteger("Size",3);fixed.setTag("Items",normal);inventory.deserializeNBT(fixed);
 }
 @Override public boolean shouldRefresh(World w,BlockPos p,IBlockState a,IBlockState b){return a.getBlock()!=b.getBlock();}
 public int field(int i){switch(i){case 0:return energy;case 1:return production;case 2:return temperature;case 3:return fuelTicks;case 4:return water();case 5:return (enabled?1:0)|(scrammed?2:0)|(formed?4:0)|(coolantGuard?8:0);default:return 0;}}
 // Client display only; server state never accepts these values from a packet.
 void setClientField(int i,int v){switch(i){case 0:energy=v;break;case 1:production=v;break;case 2:temperature=v;break;case 3:fuelTicks=v;break;case 4:clientWater=v;break;case 5:enabled=(v&1)!=0;scrammed=(v&2)!=0;formed=(v&4)!=0;coolantGuard=(v&8)!=0;break;}}
 private int clientWater;
 int displayField(int i){return i==4 && world!=null && world.isRemote?clientWater:field(i);}
}
